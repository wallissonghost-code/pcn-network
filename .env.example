# PCN é uma simulação. Nunca envie segredos ou dados reais ao GitHub.
PCN_DB=./pcn.sqlite3
PORT=8000
# 1 = cadastro bloqueado (padrão seguro); 0 = habilitar APENAS em testes locais
PCN_PRIVATE_BETA=1
# Definir no ambiente, nunca colocar o e-mail administrativo neste arquivo público
# PCN_ADMIN_EMAIL=
# Servidor escuta apenas no computador local por padrão
PCN_HOST=127.0.0.1
